# === Chaves de LLM ===
# Gemini é o provedor primário. Obtenha em https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=sua_chave_gemini_aqui

# Groq é o fallback automático. Obtenha em https://console.groq.com/keys
GROQ_API_KEY=sua_chave_groq_aqui

# === Modelos (opcional — valores padrão já funcionam) ===
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile

# === RAG (base de conhecimento) ===
# Embeddings do Gemini usam a mesma GOOGLE_API_KEY. Sem ela, o RAG é desabilitado.
EMBEDDING_MODEL=models/gemini-embedding-001
RAG_TOP_K=3

# === Câmbio ===
# AwesomeAPI é gratuita e não exige chave; URL base pode ser sobrescrita se necessário.
AWESOMEAPI_BASE_URL=https://economia.awesomeapi.com.br/json/last

# === API / UI ===
# URL que a UI (Streamlit) usa para falar com a API. Local: http://localhost:8000
# No docker-compose, o serviço 'ui' já recebe http://api:8000 automaticamente.
API_BASE_URL=http://localhost:8000

# === Sessões (Redis) ===
# Com REDIS_URL, o estado das conversas sobrevive a restart da API.
# Vazio -> MemorySaver (em memória). No compose, o serviço 'api' recebe redis://redis:6379
REDIS_URL=
